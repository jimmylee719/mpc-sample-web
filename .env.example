# 複製成 .env.local 再填值。.env.local 絕對不進版控。
#
# Cloudflare R2 的公開讀取網址前綴（自訂網域或 r2.dev 網址）。
# 只有這一個變數需要在前端用到，所以是 NEXT_PUBLIC_。
# 例：https://assets.example.com
NEXT_PUBLIC_R2_BASE=

# 以下是上傳音檔用的憑證，只在本機或 CI 使用，前端永遠拿不到。
# 這些值絕對不可以進版控，外洩要立刻在 Cloudflare 後台輪替。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
